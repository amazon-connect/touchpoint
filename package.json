{
  "name": "@amazon-connect-touchpoint/web",
  "version": "1.0.0",
  "description": "Conversational UI and SDK for Amazon Connect Customer",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "lib/index.js",
  "license": "MIT",
  "author": "Amazon Web Services",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amazon-connect/touchpoint.git"
  },
  "bugs": {
    "url": "https://github.com/amazon-connect/touchpoint/issues"
  },
  "homepage": "https://github.com/amazon-connect/touchpoint#readme",
  "module": "lib/index.js",
  "browser": "lib/index.umd.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint:check": "eslint src/",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/ --fix",
    "format": "git ls-files | grep -E '\\.(js|jsx|ts|tsx|css|html)$' | xargs prettier --write",
    "test": "typedoc --emit none && vitest run",
    "tsc": "tsc",
    "update-readme": "rm -rf docs/ && typedoc --excludeExternals --externalPattern src/components/ui/Icons.tsx && find docs -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} +"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@nlxai/core": "^1.2.7-alpha.3",
    "@react-hookz/web": "^25.0.1",
    "amazon-chime-sdk-js": "^3.32.0",
    "amazon-connect-chatjs": "^2.3.2",
    "@react-input/mask": "^2.0.4",
    "@rive-app/webgl2": "^2.31.5",
    "@types/json-schema": "^7.0.15",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "htm": "^3.1.1",
    "marked": "^15.0.4",
    "ramda": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-indiana-drag-scroll": "^2.2.0",
    "react-textarea-autosize": "^8.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^20.12.8",
    "@types/ramda": "^0.31.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "dom-accessibility-api": "^0.7.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^50.6.17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.16",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.0",
    "zod": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
